# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# --- Postgres -----------------------------------------------------------
POSTGRES_DB=agentic
POSTGRES_USER=agentic
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- OpenObserve (traces + logs) — UI at http://localhost:5080 ----------
ZO_ROOT_USER_EMAIL=admin@example.com
ZO_ROOT_USER_PASSWORD=change-me-Complex#123

# --- OTLP export from the services to OpenObserve (traces + logs) --------
OTLP_ENDPOINT=http://localhost:5080/api/default
# "Basic " + base64("<ZO_ROOT_USER_EMAIL>:<ZO_ROOT_USER_PASSWORD>"). Generate with:
#   printf 'Basic %s' "$(printf '%s:%s' admin@example.com 'change-me-Complex#123' | base64)"
OTLP_AUTH_HEADER=

# --- Grafana — UI at http://localhost:3000 ------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# --- Orchestrator -------------------------------------------------------
# API key required on approval / kill-switch endpoints (X-API-Key header).
ORCHESTRATOR_API_KEY=change-me
# OAuth2 bearer tokens (ORCH-038). Real identity provider: set ORCHESTRATOR_JWT_ISSUER_URI (OIDC
# discovery) or ORCHESTRATOR_JWT_JWK_SET_URI, plus ORCHESTRATOR_JWT_AUDIENCE if tokens carry one.
# Local development: a shared HS256 secret (>= 32 bytes, e.g. `openssl rand -base64 48`), then
# mint tokens with `python3 scripts/mint_dev_jwt.py --user alice`. All empty = JWT disabled.
ORCHESTRATOR_JWT_ISSUER_URI=
ORCHESTRATOR_JWT_JWK_SET_URI=
ORCHESTRATOR_JWT_AUDIENCE=
ORCHESTRATOR_JWT_HMAC_SECRET=
# LLM mode: "mock" replays recorded responses (default, offline); "claude" calls the API.
LLM_MODE=mock
# Only needed when LLM_MODE=claude.
ANTHROPIC_API_KEY=
