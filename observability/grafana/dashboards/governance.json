{
  "uid": "orchestrator-governance",
  "title": "Governance",
  "description": "Gates, retries, rollbacks and human checkpoints.",
  "tags": [
    "agentic-sdlc"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
